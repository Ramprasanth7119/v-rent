# ---------------------------------------------------------------- payments
# Copy to .env.local. With every value left blank the payment routes run in
# sandbox mode: real code paths, real signatures, no real money.

# "live" turns off sandbox mode and the /api/payments/sandbox route.
PAYMENTS_MODE=sandbox

# How V-RENT stands with IRAS. Drives the tax line and the invoice.
#   not-gst-registered  below the S$1m threshold — no GST may be charged
#   gst-registered      V-RENT charges 9% and files it
#   merchant-of-record  the provider (Dodo) sells to the agent and files the tax
PAYMENTS_TAX_TREATMENT=not-gst-registered

PAYNOW_QR_TTL_MINUTES=10
PAYMENTS_OUTBOUND_CONCURRENCY=24

# ---- PayNow (direct rail against V-RENT's own corporate UEN)
# Requires a Singapore-incorporated entity with a UEN and PayNow Corporate
# enabled on an SGD business account.
PAYNOW_UEN=
PAYNOW_MERCHANT_NAME=V-RENT
# Shared secret for the bank/PSP reconciliation callback that confirms credits.
PAYNOW_WEBHOOK_SECRET=

# ---- Razorpay Singapore (hosted Payment Link: cards + PayNow)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Dodo Payments (merchant of record)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_API_BASE=https://test.dodopayments.com

# ---- Stripe (test mode only, as the POC scope requires)
# From the Stripe dashboard in test mode. A key that does not begin sk_test_ is
# refused by the provider, so the proof of concept cannot charge anybody.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- OneMap (Singapore Land Authority address and map service)
# Free account at onemap.gov.sg. The search endpoint currently answers without
# one and warns; the token removes the warning and the rate limit.
ONEMAP_TOKEN=

# ---- Mail
# With neither set, confirmation messages are written to .data/outbox instead
# of being delivered, and the interface says so.
SMTP_URL=
MAIL_PROVIDER=

# ---------------------------------------------------------------- accounts
# The operations account. Seeded on first sign-in if it does not exist.
VRENT_ADMIN_EMAIL=admin@vrent.sg
VRENT_ADMIN_PASSWORD=

# A demo agent, seeded with a portfolio that has already been used so the
# product can be shown end to end. Every other account starts with drafts and
# an empty inbox.
VRENT_DEMO_AGENT_EMAIL=
VRENT_DEMO_AGENT_PASSWORD=
VRENT_DEMO_AGENT_CEA=
VRENT_DEMO_AGENT_MOBILE=

# The key session cookies are signed with. 32+ random characters:
#   openssl rand -hex 32
# Left blank it is generated once and kept beside the data, which is fine on a
# laptop. On a serverless platform there is nowhere durable to keep it, so each
# instance would generate its own and a cookie signed by one would be rejected
# by the next — the session would appear to work and then silently vanish.
# The server refuses to start a session there rather than behave that way.
VRENT_SESSION_SECRET=

# ---------------------------------------------------------------- storage
# Where state is written. Left blank it is `.data` beside the source locally,
# and /tmp on a serverless platform — which is the only writable path there,
# and does not survive a cold start. Point this at a mounted volume to keep it.
VRENT_DATA_DIR=
